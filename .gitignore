# Entorno virtual y artefactos de build. '.venv' sin barra cubre también el caso
# en que sea un symlink al venv del árbol principal, como pasa en un worktree.
.venv
.venv/
venv/
*.egg-info/
build/
dist/

# Cachés de Python y herramientas
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Sistema operativo
.DS_Store

# Excel: archivos de bloqueo que crea al abrir un libro
~$*.xlsx
~$*.xlsm

# El libro base lo regenera 'python -m motor_tes.cli excel' a partir de la curva
# calibrada, así que no tiene sentido versionarlo. El .xlsm SÍ se versiona: lleva
# los módulos VBA incorporados y es parte del entregable.
excel/motor_tes_forwards.xlsx

# Las figuras de validation/figs/ SÍ se versionan: el reporte las embebe y, sin
# ellas, GitHub lo renderiza con imágenes rotas.

# NOTA sobre data/: los snapshots de data/raw/ y data/manifest.json SÍ se versionan
# a propósito. Son la evidencia de procedencia (URL, timestamp, SHA256, origen
# api/manual_export) que respalda cada número del reporte, y el export manual de la
# curva TES no se puede volver a descargar de forma automática.

# Cotizaciones licenciadas de un proveedor comercial. NO se versionan: este repo es
# público y redistribuir la serie de precios violaría la licencia. Lo que sí va al
# repo es data/instrumentos_tes.csv (RIC, cupón y vencimiento son hechos públicos de
# un emisor soberano) y, en el reporte, resultados agregados: nunca la tabla de
# precios ni los residuales instrumento por instrumento, que combinados con los
# parámetros de la curva permitirían reconstruirla.
data/privado/
validation/privado/
